// This file generated via KaravaiSV templating engine (https://github.com/BIG-Denis/karavaisv).
//
// @author: BIG-Denis (https://github.com/BIG-Denis)
// @description: Module that realligns instructions, calucletes PC and early finds branches and jumps
//

module </ module_id />_reallign_unit
import </ module_id />_pkg::*;
#(
  parameter  int unsigned RESET_PC      = unsigned'(int'('0));

  localparam int unsigned WAYS_NUM      = PIPELINE_WIDTH,
  localparam int unsigned WAY_PTR_WIDTH = $clog2(WAYS_NUM)
) (

////////////////////////////// EXTERNAL SIGNALS DECLARATION /////////////////////////////

  input  logic                             clk_i,
  input  logic                             rstn_i,

  // Pipeline
  input  logic                             stall_i,
  input  logic                             flush_i,

  // IQ (Instruction Queue)
  input  logic                             iq_instr_pack_v_i,
  input  logic [IQ_INSTR_PACK_WIDTH - 1:0] iq_instr_pack_i,
  output logic [IQ_READ_WIDTH - 1:0]       iq_instr_pack_read_v_o,

  // BP (Branch Predictor)
  output logic                             bp_predict_v_o,
  output logic [BP_HASH_BITS_NUM - 1:0]    bp_predict_hash_o,

  // RAS (Return Address Stack)
  input  logic [PC_WIDTH - 1:0]            ras_return_pc_i,

  // DEC (Decoder)
  input  logic                             dec_goto_ras_v_i,
  input  logic                             dec_goto_v_i,
  input  logic [PC_WIDTH - 1:0]            dec_pc_i,

  output logic [WAYS_NUM - 1:0]            dec_raw_instr_v_o,
  output logic [LONG_INSTR_WIDTH - 1:0]    dec_raw_instr_o [0:WAYS_NUM - 1],

  output window_pc_t                       dec_window_pc_o,

  output logic [PC_WIDTH - 1:0]            dec_bj_instr_pc_o,
  output logic [DATA_WIDTH - 1:0]          dec_bj_imm_o,
  output logic                             dec_branch_v_o,
  output logic                             dec_jal_v_o,
  output logic                             dec_jalr_v_o,
  output logic [WAY_PTR_WIDTH - 1:0]       dec_bj_ptr_o
);

///////////////////////////// INTERNAL CONSTANTS DECLARATION ////////////////////////////

// Previous instructions counters widths
<$ for instr in range(pipeline_width): $>
localparam int unsigned PREV_</ instr />_NUM_WIDTH = $clog2(</ instr /> + 1);
<$ end $>

// Instruction offset width
localparam int unsigned INSTR_OFFSET_WIDTH         = $clog2(IQ_INSTR_PACK_WIDTH);

// PC increment width
//   increment width is a 4 bytes per instruction * instruction num per window
localparam int unsigned PC_INCR_WIDTH              = $clog2(PIPELINE_WIDTH * 4)

////////////////////////////// INTERNAL SIGNALS DECLARATION /////////////////////////////

// Reallign instructions

logic [WAYS_NUM - 1:0]                   is_long_instr;

<$ for instr in range(pipeline_width): $>
logic [PREV_</ instr />_NUM_WIDTH - 1:0] long_instr_num_prev_</ instr />;
<$ end $>

logic [INSTR_OFFSET_WIDTH - 1:0]         instr_offset       [0:WAYS_NUM - 1];
logic [LONG_INSTR_WIDTH - 1:0]           realligned_instr   [0:WAYS_NUM - 1];

// instructions PC

logic [PC_INCR_WIDTH - 1:0]              base_pc_incr;

logic                                    base_pc_en;
logic [PC_WIDTH - 1:0]                   base_pc_next;
logic [PC_WIDTH - 1:0]                   base_pc_ff;

logic [PC_WIDTH - 1:0]                   instr_pc           [0:WAYS_NUM - 1];

window_pc_t                              window_pc;

// Branch and jump detection

logic [WAYS_NUM - 1:0]                   is_branch_vec;
logic [WAYS_NUM - 1:0]                   is_jal_vec;
logic [WAYS_NUM - 1:0]                   is_jalr_vec;

logic                                    is_branch_v;
logic                                    is_jal_v;
logic                                    is_jalr_v;
logic [WAY_PTR_WIDTH - 1:0]              bj_instr_ptr;

logic [WAYS_NUM - 1:0]                   is_pending_bj_instr;

logic                                    bj_processed_en;
logic [WAYS_NUM - 1:0]                   bj_processed_next;
logic [WAYS_NUM - 1:0]                   bj_processed_ff;

// DEC egress registers

logic [WAYS_NUM - 1:0]                   dec_raw_instr_v_next;
logic [WAYS_NUM - 1:0]                   dec_raw_instr_v_ff;

logic [WAYS_NUM - 1:0]                   dec_egr_en;

logic [LONG_INSTR_WIDTH - 1:0]           dec_raw_instr_next [0:WAYS_NUM - 1];
logic [PC_WIDTH - 1:0]                   dec_bj_instr_pc_next;
logic [DATA_WIDTH - 1:0]                 dec_bj_imm_next;
logic                                    dec_branch_v_next;
logic                                    dec_jal_v_next;
logic                                    dec_jalr_v_next;
logic [WAY_PTR_WIDTH - 1:0]              dec_bj_ptr_next;

logic [LONG_INSTR_WIDTH - 1:0]           dec_raw_instr_ff   [0:WAYS_NUM - 1];
logic [PC_WIDTH - 1:0]                   dec_bj_instr_pc_ff;
logic [DATA_WIDTH - 1:0]                 dec_bj_imm_ff;
logic                                    dec_branch_v_ff;
logic                                    dec_jal_v_ff;
logic                                    dec_jalr_v_ff;
logic [WAY_PTR_WIDTH - 1:0]              dec_bj_ptr_ff;

logic                                    dec_egr_window_pc_en;

window_pc_t                              dec_window_pc_next;
window_pc_t                              dec_window_pc_ff;


////////////////////////////// INTERNAL SIGNALS ASSIGNMENT //////////////////////////////

// TBD


///////////////////////////////// REALLIGN INSTRUCTIONS /////////////////////////////////

// count number of previous long instructions

<$ for instr_dec in range(pipeline_width): $>
assign long_instr_num_prev_</ instr_dec /> =
<$   for instr_prev in range(instr_dec): $>
                                             PREV_</ instr_dec />_NUM_WIDTH'(is_long_instr[</ instr_prev />]) +
<$   end $>
                                             PREV_</ instr_dec />_NUM_WIDTH'('0);

<$ end $>

// count offset for instructions allignment

// offset are always consists of 16 bit instruction base
// and additional 16 bits if instruction are long
<$ for instr_dec in range(pipeline_width): $>
assign instr_offset[</ instr_dec />] = 16 * </ instr_dec /> + 16 * long_instr_num_prev_</ instr_dec />;
<$ end $>

// allign instructions

<$ for instr_dec in range(pipeline_width): $>
assign realligned_instr[</ instr_dec />] = iq_instr_pack_i[instr_offset[</ instr_dec />] +: 32];
<$ end $>

// detect long instructions

<$ for instr_dec in range(pipeline_width): $>
assign is_long_instr[</ instr_dec />] = realligned_instr[</ instr_dec />][1:0] != 2'b11;
<$ end $>


//////////////////////////////// PROGRAM COUNTER HANDLING ///////////////////////////////

// PC incrememt per processing registers

assign base_pc_incr =
<$ for instr in range(pipeline_width): $>
                      is_long_instr ? PC_INCR_WIDTH'('h4) : PC_INCR_WIDTH'('h2) +
<$ end $>
                      PC_INCR_WIDTH'('0);

// program counter

assign base_pc_next = // goto calculated PC from decode stage (jump or RAS push)
                      dec_goto_v_i     ? dec_pc_i
                      // goto RAS top (RAS pop)
                    : dec_goto_ras_v_i ? ras_return_pc_i
                      // increment PC for read instruction
                    : base_pc_ff + PC_WIDTH'(base_pc_incr);

assign base_pc_en = // goto some PC
                    dec_goto_v_i | dec_goto_ras_v_i |
                    // new instructions (PC increment)
                    iq_instr_pack_v_i & stall_i;

always_ff @(posedge clk_i or negedge rstn_i) begin
  if (~rstn_i) begin
    base_pc_ff <= RESET_PC;
  end
  else begin
    if (base_pc_en) begin
      base_pc_ff <= base_pc_next;
    end
  end
end


////////////////////////////// INSTRUCTIONS PC CALCULATION //////////////////////////////

// calculation PC for each instruction

// PC for each instruction is a base PC and +2 or +4 bytes
// depending on long or compressed instruction
<$ for instr_dec in range(pipeline_width): $>
assign instr_pc[</ instr_dec />] =
<$   for instr_prev in range(instr_dec): $>
                                   (is_long_instr[</ instr_prev />] ? PC_WIDTH'('d4) : PC_WIDTH'('d2)) +
<$   end $>
                                   base_pc_ff;

<$ end $>

// window PC assignment

assign window_pc.base_pc           = base_pc_ff;
assign window_pc.is_long_instr_vec = is_long_instr;


/////////////////////////////// BRANCH AND JUMP DETECTION ///////////////////////////////

// find BJ instructions

<$ for instr_dec in range(pipeline_width): $>
// instruction </ instr_dec />
assign is_branch_vec[</ instr_dec />] = (realligned_instr[6:0] == 7'b1100011);  // branch
assign is_jal_vec   [</ instr_dec />] = (realligned_instr[6:0] == 7'b1101111);  // jal
assign is_jalr_vec  [</ instr_dec />] = (realligned_instr[6:0] == 7'b1100111);  // jalr

<$ end $>

// any BJ instructuions vector

assign is_pending_bj_instr = (is_branch_vec | is_jal_vec | is_jalr_vec) & ~bj_processed_ff;

// find first BJ entry

always_comb begin
  priority case (1'b1)
<$ for instr_dec in range(pipeline_width): $>
    is_pending_bj_instr[</ instr_dec />]: begin
      bj_instr_ptr = WAY_PTR_WIDTH'(</ instr_dec />);
      is_branch_v  = is_branch_vec[</ instr_dec />];
      is_jal_v     = is_jal_vec   [</ instr_dec />];
      is_jalr_v    = is_jalr_vec  [</ instr_dec />];
    end

<$ end $>
    default: begin
      bj_instr_ptr = WAY_PTR_WIDTH'('x);
      is_branch_v  = 1'b0;
      is_jal_v     = 1'b0;
      is_jalr_v    = 1'b0;
    end
  endcase
end


////////////////////////////////// PROGRESSION CONTROL //////////////////////////////////

// TODO: one jump and one branch per window

// TBD


//////////////////////////////////// EGRESS REGISTERS ///////////////////////////////////

// TBD


/////////////////////////////// OUTPUT SIGNALS ASSIGNMENT ///////////////////////////////

// TBD


<$ if assertions: $>
/////////////////////////////////////// ASSERTIONS //////////////////////////////////////

// TBD


<$ end $>


endmodule
